!(import! &self (library estream lib_estream))

(= (kbitem) (Sentence ((--> flood catastrophe) (stv 1.0 0.9)) (-1)))
(= (kbitem) (Sentence ((--> landslide catastrophe) (stv 1.0 0.9)) (-1)))


!(let $temp (AddSeq (
          ((--> cloud observation) (--> monsoon time))
          ((--> rain observation) (--> monsoon time))
          ((--> flood observation) (--> monsoon time))
          (delay)
          ((--> cloud observation) (--> monsoon time))
          ((--> rain observation) (--> monsoon time))
          ((--> landslide observation) (--> monsoon time))
          (delay)
          ((--> cloud observation) (--> monsoon time))
          ((--> rain observation) (--> monsoon time))
          (delay)
          ((--> cloud observation) (--> monsoon time))
          ((--> rain observation) (--> monsoon time))
          (delay)
          ((--> cloud observation) (--> monsoon time))
          ((--> rain observation) (--> monsoon time))
          (delay)
          ((--> cloud observation) (--> winter time))
          ((--> rain observation) (--> winter time))
          (delay)
          ((--> cloud observation) (--> winter time))
          ((--> rain observation) (--> winter time))
          (delay))
          )  
       (empty))

!(test (QueryBest (=/> $how (--> catastrophe observation)))
       ((=/> (&| (--> rain observation) (--> monsoon time)) (--> catastrophe observation)) (stv 0.17618429591174564 0.6197230416595986)))
